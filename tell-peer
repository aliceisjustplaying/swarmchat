#!/usr/bin/env python3
"""Send one message to the other Herdr agent and append to chat.log."""

import datetime
import fcntl
import os
from pathlib import Path
import subprocess
import sys


def main():
    if len(sys.argv) != 3 or sys.argv[1] not in ("claude", "astra"):
        print("Usage: tell-peer claude|astra 'message' (name yourself as sender)", file=sys.stderr)
        return 2
    sender, message = sys.argv[1:]
    if not message.strip():
        print("Message cannot be empty.", file=sys.stderr)
        return 2
    if os.environ.get("HERDR_ENV") != "1":
        print("Run this inside a Herdr pane.", file=sys.stderr)
        return 2
    recipient = "astra" if sender == "claude" else "claude"
    log_path = Path(__file__).resolve().with_name("chat.log")
    stamp = datetime.datetime.now().astimezone().strftime("%H:%M:%S")
    # Serialize sends so complete multiline messages stay together in the log.
    with log_path.open("a", encoding="utf-8") as log:
        fcntl.flock(log, fcntl.LOCK_EX)
        log.write(f"\n[{stamp}] {sender} → {recipient}\n{message}\n")
        log.flush()
        try:
            result = subprocess.run(
                ["herdr", "agent", "prompt", recipient, f"From peer {sender}:\n{message}"],
                capture_output=True,
                text=True,
            )
        except OSError as error:
            log.write(f"[NOT SENT] {error}\n")
            print(f"Not sent: {error}", file=sys.stderr)
            return 1
        if result.returncode:
            detail = (result.stderr or result.stdout).strip()
            log.write(f"[DELIVERY ERROR — check recipient before retrying] {detail}\n")
            print(f"Herdr delivery error: {detail}", file=sys.stderr)
            return 1
    print(f"Sent to {recipient}.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
